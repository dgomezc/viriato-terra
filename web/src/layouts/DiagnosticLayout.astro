---
import '../styles/global.css';

const { title = 'Viriato Terra · Diagnóstico' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
  </head>
  <body>
    <main class="mx-auto min-h-screen max-w-4xl px-6 py-16 lg:px-10">
      <slot />
    </main>
  </body>
</html>
